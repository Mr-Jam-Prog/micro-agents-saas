 *   apiEndpoint: 'https://api.example.com',
 *   enableCaching: true
 * });
 * 
 * const result = await agent.execute({
 *   // données d'entrée
 * });
 * ```
 */
export class {{ agent_name }} {
  // ===========================================================================
  // PROPRIÉTÉS STATIQUES
  // ===========================================================================
  
  /** Version de l'agent */
  public static readonly VERSION = '{{ version }}';
  
  /** Nom de l'agent */
  public static readonly AGENT_NAME = '{{ agent_name }}';
  
  /** Configuration par défaut */
  private static readonly DEFAULT_CONFIG: Required<{{ agent_name }}Config> = {
    apiEndpoint: '{{ default_api_endpoint }}',
    timeoutMs: 30000,
    maxRetries: 3,
    enableCaching: true,
    cacheTTL: 300000, // 5 minutes
    theme: 'auto',
    locale: 'en-US',
    enableTelemetry: true,
    sampleRate: 0.1,
    enableEncryption: true,
    maskSensitiveData: true,
    
    // Configuration de base de l'agent
    agentId: '{{ agent_id }}',
    environment: 'production',
    logLevel: 'info',
    enableMetrics: true
  };
  
  // ===========================================================================
  // PROPRIÉTÉS D'INSTANCE
  // ===========================================================================
  
  /** Configuration actuelle */
  private config: Required<{{ agent_name }}Config>;
  
  /** État de l'agent */
  private state: {{ agent_name }}State;
  
  /** Cache en mémoire */
  private cache: Map<string, { data: {{ agent_name }}Output; expiresAt: number }>;
  
  /** Écouteurs d'événements */
  private eventListeners: Map<keyof {{ agent_name }}Events, Set<Function>>;
  
  /** AbortController pour les requêtes en cours */
  private abortController: AbortController | null;
  
  /** API client pour les appels réseau */
  private apiClient: {
    post: <T>(url: string, data: unknown, options?: RequestInit) => Promise<T>;
    get: <T>(url: string, options?: RequestInit) => Promise<T>;
  };
  
  // ===========================================================================
  // CONSTRUCTEUR
  // ===========================================================================
  
  /**
   * Crée une nouvelle instance de l'agent
   * 
   * @param userConfig - Configuration personnalisée (optionnelle)
   */
  constructor(userConfig: {{ agent_name }}Config = {}) {
    // Fusionner la configuration
    this.config = {
      ...{{ agent_name }}.DEFAULT_CONFIG,
      ...userConfig
    };
    
    // Initialiser l'état
    this.state = {
      status: {{ agent_name }}Status.IDLE,
      data: null,
      error: null,
      lastUpdated: new Date(),
      executionCount: 0,
      cacheStats: {
        hits: 0,
        misses: 0,
        size: 0
      }
    };
    
    // Initialiser le cache
    this.cache = new Map();
    
    // Initialiser les écouteurs d'événements
    this.eventListeners = new Map();
    
    // Initialiser l'AbortController
    this.abortController = null;
    
    // Configurer le client API
    this.apiClient = this.createApiClient();
    
    // Configurer le monitoring
    if (this.config.enableTelemetry) {
      this.setupTelemetry();
    }
    
    // Configurer l'internationalisation
    i18n.setLocale(this.config.locale);
    
    this.emit('status-change', this.state.status);
  }
  
  // ===========================================================================
  // MÉTHODES PUBLIQUES
  // ===========================================================================
  
  /**
   * Exécute l'agent avec les données d'entrée fournies
   * 
   * @param input - Données d'entrée
   * @param options - Options d'exécution (optionnelles)
   * @returns Résultat de l'exécution
   * 
   * @throws {{ agent_name }}ValidationError - Si les données d'entrée sont invalides
   * @throws {{ agent_name }}NetworkError - En cas d'erreur réseau
   * @throws {{ agent_name }}TimeoutError - En cas de timeout
   * @throws {{ agent_name }}Error - Pour toutes les autres erreurs
   */
  @instrumentMethod
  @validateInput(validate{{ agent_name }}Input)
  @auditTrail('{{ agent_name }}.execute')
  public async execute(
    input: {{ agent_name }}Input,
    options: {{ agent_name }}ExecutionOptions = {}
  ): Promise<{{ agent_name }}Output> {
    const executionId = this.generateExecutionId();
    const startTime = performance.now();
    
    try {
      // Émettre l'événement de début
      this.emit('execution-start', { input, options });
      
      // Mettre à jour l'état
      this.updateState({ 
        status: {{ agent_name }}Status.PROCESSING,
        error: null
      });
      
      // Vérifier le cache (si activé et non bypassé)
      let result: {{ agent_name }}Output;
      const cacheKey = generateCacheKey(input);
      
      if (this.config.enableCaching && !options.bypassCache) {
        const cached = this.cache.get(cacheKey);
        if (cached && cached.expiresAt > Date.now()) {
          this.state.cacheStats.hits++;
          this.emit('cache-hit', { key: cacheKey, data: cached.data });
          result = cached.data;
          
          // Mettre à jour les métadonnées
          result.metadata.cacheHit = true;
          result.metadata.executionId = executionId;
          result.metadata.processingTimeMs = performance.now() - startTime;
          result.metadata.timestamp = new Date().toISOString();
          
          this.updateState({ 
            status: {{ agent_name }}Status.SUCCESS,
            data: result,
            lastUpdated: new Date()
          });
          
          this.emit('execution-success', { 
            output: result, 
            durationMs: result.metadata.processingTimeMs 
          });
          
          return result;
        }
        this.state.cacheStats.misses++;
        this.emit('cache-miss', { key: cacheKey });
      }
      
      // Créer un nouvel AbortController pour cette exécution
      this.abortController = new AbortController();
      const timeoutMs = options.timeoutMs || this.config.timeoutMs;
      
      // Configurer le timeout
      const timeoutId = setTimeout(() => {
        if (this.abortController) {
          this.abortController.abort(new {{ agent_name }}TimeoutError(
            `Execution timeout after ${timeoutMs}ms`,
            timeoutMs
          ));
        }
      }, timeoutMs);
      
      try {
        // Exécuter la logique métier avec retry
        result = await withRetry(
          () => this.executeBusinessLogic(input, executionId, options),
          {
            maxRetries: this.config.maxRetries,
            retryDelay: (attempt) => Math.min(1000 * 2 ** attempt, 10000)
          }
        );
        
      } finally {
        clearTimeout(timeoutId);
        this.abortController = null;
      }
      
      // Calculer le temps de traitement
      const processingTimeMs = performance.now() - startTime;
      result.metadata.processingTimeMs = processingTimeMs;
      
      // Mettre en cache le résultat (si activé)
      if (this.config.enableCaching) {
        this.cache.set(cacheKey, {
          data: result,
          expiresAt: Date.now() + this.config.cacheTTL
        });
        this.state.cacheStats.size = this.cache.size;
      }
      
      // Mettre à jour l'état
      this.updateState({
        status: {{ agent_name }}Status.SUCCESS,
        data: result,
        lastUpdated: new Date(),
        executionCount: this.state.executionCount + 1
      });
      
      // Émettre l'événement de succès
      this.emit('execution-success', { 
        output: result, 
        durationMs: processingTimeMs 
      });
      
      return result;
      
    } catch (error) {
      const processingTimeMs = performance.now() - startTime;
      
      // Gérer l'erreur
      const agentError = this.normalizeError(error);
      
      // Mettre à jour l'état
      this.updateState({
        status: {{ agent_name }}Status.ERROR,
        error: agentError,
        lastUpdated: new Date()
      });
      
      // Émettre l'événement d'erreur
      this.emit('execution-error', { 
        error: agentError, 
        input 
      });
      
      throw agentError;
    }
  }
  
  /**
   * Exécute l'agent en batch
   * 
   * @param inputs - Liste des données d'entrée
   * @param options - Options d'exécution (optionnelles)
   * @returns Liste des résultats
   */
  public async executeBatch(
    inputs: {{ agent_name }}Input[],
    options: {{ agent_name }}ExecutionOptions = {}
  ): Promise<{{ agent_name }}Output[]> {
    const maxConcurrency = options.priority === 'high' ? 3 : 1;
    const semaphore = new Semaphore(maxConcurrency);
    const results: {{ agent_name }}Output[] = [];
    const errors: Error[] = [];
    
    const executeWithSemaphore = async (input: {{ agent_name }}Input): Promise<void> => {
      await semaphore.acquire();
      try {
        const result = await this.execute(input, options);
        results.push(result);
      } catch (error) {
        errors.push(error as Error);
      } finally {
        semaphore.release();
      }
    };
    
    await Promise.all(inputs.map(executeWithSemaphore));
    
    if (errors.length > 0) {
      console.warn(`${errors.length} executions failed in batch`, errors);
    }
    
    return results;
  }
  
  /**
   * Réinitialise l'état de l'agent
   */
  public reset(): void {
    this.updateState({
      status: {{ agent_name }}Status.IDLE,
      data: null,
      error: null,
      executionCount: 0,
      cacheStats: {
        hits: 0,
        misses: 0,
        size: 0
      }
    });
    
    // Nettoyer le cache
    this.cache.clear();
    
    // Annuler les requêtes en cours
    if (this.abortController) {
      this.abortController.abort();
      this.abortController = null;
    }
  }
  
  /**
   * Rafraîchit les données (ré-exécute avec les dernières entrées)
   */
  public async refresh(): Promise<{{ agent_name }}Output> {
    if (!this.state.data) {
      throw new {{ agent_name }}Error('No data to refresh');
    }
    
    // Extraire l'input original des métadonnées (si stocké)
    const lastInput = this.state.data.metadata as unknown as {{ agent_name }}Input;
    return this.execute(lastInput, { bypassCache: true });
  }
  
  /**
   * Vérifie la santé de l'agent
   */
  public async healthCheck(): Promise<{
    status: 'healthy' | 'degraded' | 'unhealthy';
    checks: Record<string, boolean>;
    timestamp: string;
    version: string;
  }> {
    const checks: Record<string, boolean> = {
      agentInitialized: true,
      cacheOperational: this.cache instanceof Map,
      apiReachable: false,
      memoryUsage: this.getMemoryUsage() < 0.8 // Moins de 80% d'utilisation
    };
    
    try {
      // Vérifier l'accessibilité de l'API
      const response = await fetch(`${this.config.apiEndpoint}/health`, {
        signal: AbortSignal.timeout(5000)
      });
      checks.apiReachable = response.ok;
    } catch {
      checks.apiReachable = false;
    }
    
    const allHealthy = Object.values(checks).every(check => check);
    const someHealthy = Object.values(checks).some(check => check);
    
    return {
      status: allHealthy ? 'healthy' : someHealthy ? 'degraded' : 'unhealthy',
      checks,
      timestamp: new Date().toISOString(),
      version: {{ agent_name }}.VERSION
    };
  }
  
  /**
   * Récupère les métriques de performance
   */
  public getMetrics(): PerformanceMetrics {
    return {
      executionCount: this.state.executionCount,
      averageProcessingTime: this.calculateAverageProcessingTime(),
      cacheHitRate: this.state.cacheStats.hits / 
                   (this.state.cacheStats.hits + this.state.cacheStats.misses) || 0,
      errorRate: this.calculateErrorRate(),
      lastExecutionTime: this.state.lastUpdated,
      memoryUsage: this.getMemoryUsage()
    };
  }
  
  /**
   * Abonne un écouteur à un événement
   */
  public on<K extends keyof {{ agent_name }}Events>(
    event: K,
    listener: (data: {{ agent_name }}Events[K]) => void
  ): () => void {
    if (!this.eventListeners.has(event)) {
      this.eventListeners.set(event, new Set());
    }
    
    this.eventListeners.get(event)!.add(listener);
    
    // Retourner une fonction de désabonnement
    return () => {
      this.eventListeners.get(event)?.delete(listener);
    };
  }
  
  /**
   * Désabonne tous les écouteurs d'un événement
   */
  public off<K extends keyof {{ agent_name }}Events>(event: K): void {
    this.eventListeners.delete(event);
  }
  
  // ===========================================================================
  // MÉTHODES PRIVÉES
  // ===========================================================================
  
  /**
   * Exécute la logique métier principale
   */
  @measurePerformance('business_logic')
  private async executeBusinessLogic(
    input: {{ agent_name }}Input,
    executionId: string,
    options: {{ agent_name }}ExecutionOptions
  ): Promise<{{ agent_name }}Output> {
    // Logique métier spécifique à l'agent
    // Cette méthode doit être implémentée selon les besoins
    
    // Exemple d'implémentation:
    // 1. Prétraitement des données
    const processedData = await this.preprocessInput(input);
    
    // 2. Application des règles métier
    const businessRulesResult = await this.applyBusinessRules(processedData);
    
    // 3. Appel API (si nécessaire)
    const apiResult = await this.callExternalApi(businessRulesResult);
    
    // 4. Post-traitement
    const finalResult = await this.postprocessResult(apiResult);
    
    // 5. Génération de la sortie
    return this.generateOutput(finalResult, executionId);
  }
  
  /**
   * Prétraite les données d'entrée
   */
  private async preprocessInput(input: {{ agent_name }}Input): Promise<unknown> {
    // Implémentation spécifique
    return input;
  }
  
  /**
   * Applique les règles métier
   */
  private async applyBusinessRules(data: unknown): Promise<unknown> {
    // Implémentation spécifique
    return data;
  }
  
  /**
   * Appelle l'API externe
   */
  private async callExternalApi(data: unknown): Promise<unknown> {
    if (!this.config.apiEndpoint) {
      throw new {{ agent_name }}ConfigurationError('API endpoint not configured');
    }
    
    try {
      const response = await this.apiClient.post<unknown>(
        `${this.config.apiEndpoint}/process`,
        data,
        {
          signal: this.abortController?.signal,
          headers: {
            'Content-Type': 'application/json',
            'X-Execution-Id': this.generateExecutionId()
          }
        }
      );
      
      return response;
    } catch (error) {
      if (error instanceof Error && error.name === 'AbortError') {
        throw new {{ agent_name }}TimeoutError('API call aborted');
      }
      
      throw new {{ agent_name }}NetworkError(
        `API call failed: ${error instanceof Error ? error.message : String(error)}`,
        (error as any)?.status,
        this.config.apiEndpoint
      );
    }
  }
  
  /**
   * Post-traite les résultats
   */
  private async postprocessResult(data: unknown): Promise<unknown> {
    // Implémentation spécifique
    return data;
  }
  
  /**
   * Génère la sortie structurée
   */
  private generateOutput(data: unknown, executionId: string): {{ agent_name }}Output {
    return {
      data: data as {{ agent_name }}Output['data'],
      metadata: {
        executionId,
        agentVersion: {{ agent_name }}.VERSION,
        processingTimeMs: 0, // Serra mis à jour par l'appelant
        timestamp: new Date().toISOString()
      }
    };
  }
  
  /**
   * Crée le client API
   */
  private createApiClient() {
    return {
      post: async <T>(url: string, data: unknown, options: RequestInit = {}): Promise<T> => {
        const response = await fetch(url, {
          method: 'POST',
          body: JSON.stringify(data),
          headers: {
            'Content-Type': 'application/json',
            ...options.headers
          },
          signal: options.signal,
          ...options
        });
        
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        
        return response.json() as Promise<T>;
      },
      
      get: async <T>(url: string, options: RequestInit = {}): Promise<T> => {
        const response = await fetch(url, {
          method: 'GET',
          headers: options.headers,
          signal: options.signal,
          ...options
        });
        
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        
        return response.json() as Promise<T>;
      }
    };
  }
  
  /**
   * Configure la télémétrie
   */
  private setupTelemetry(): void {
    // Configuration des métriques
    trackMetrics('agent_initialized', {
      agent: {{ agent_name }}.AGENT_NAME,
      version: {{ agent_name }}.VERSION,
      config: maskSensitiveData(this.config)
    });
    
    // Écouter les événements pour la télémétrie
    this.on('execution-success', ({ output, durationMs }) => {
      trackMetrics('execution_success', {
        agent: {{ agent_name }}.AGENT_NAME,
        durationMs,
        outputSize: JSON.stringify(output).length
      });
    });
    
    this.on('execution-error', ({ error }) => {
      trackMetrics('execution_error', {
        agent: {{ agent_name }}.AGENT_NAME,
        errorCode: error instanceof {{ agent_name }}Error ? error.code : 'UNKNOWN'
      });
    });
  }
  
  /**
   * Normalise les erreurs
   */
  private normalizeError(error: unknown): {{ agent_name }}Error {
    if (error instanceof {{ agent_name }}Error) {
      return error;
    }
    
    if (error instanceof Error) {
      return new {{ agent_name }}Error(error.message);
    }
    
    return new {{ agent_name }}Error(String(error));
  }
  
  /**
   * Met à jour l'état de l'agent
   */
  private updateState(updates: Partial<{{ agent_name }}State>): void {
    const oldStatus = this.state.status;
    
    this.state = {
      ...this.state,
      ...updates
    };
    
    // Émettre l'événement de changement de statut si nécessaire
    if (updates.status && updates.status !== oldStatus) {
      this.emit('status-change', updates.status);
    }
  }
  
  /**
   * Émet un événement
   */
  private emit<K extends keyof {{ agent_name }}Events>(
    event: K,
    data: {{ agent_name }}Events[K]
  ): void {
    const listeners = this.eventListeners.get(event);
    if (listeners) {
      listeners.forEach(listener => {
        try {
          listener(data);
        } catch (error) {
          console.error(`Error in event listener for ${event}:`, error);
        }
      });
    }
  }
  
  /**
   * Génère un ID d'exécution unique
   */
  private generateExecutionId(): string {
    return `{{ agent_name_snake }}_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
  }
  
  /**
   * Calcule le temps de traitement moyen
   */
  private calculateAverageProcessingTime(): number {
    // Implémentation simplifiée
    return this.state.executionCount > 0 ? 100 : 0; // Valeur par défaut
  }
  
  /**
   * Calcule le taux d'erreur
   */
  private calculateErrorRate(): number {
    // Implémentation simplifiée
    return 0;
  }
  
  /**
   * Récupère l'utilisation mémoire
   */
  private getMemoryUsage(): number {
    if ('memory' in performance) {
      const memory = (performance as any).memory;
      return memory.usedJSHeapSize / memory.jsHeapSizeLimit;
    }
    return 0;
  }
}

