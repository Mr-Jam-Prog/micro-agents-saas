  const statusConfig = {
    [{{ agent_name }}Status.IDLE]: {
      label: 'Inactif',
      color: 'gray',
      icon: '⏸️'
    },
    [{{ agent_name }}Status.LOADING]: {
      label: 'Chargement',
      color: 'blue',
      icon: '⏳'
    },
    [{{ agent_name }}Status.PROCESSING]: {
      label: 'Traitement',
      color: 'yellow',
      icon: '⚡'
    },
    [{{ agent_name }}Status.SUCCESS]: {
      label: 'Succès',
      color: 'green',
      icon: '✅'
    },
    [{{ agent_name }}Status.ERROR]: {
      label: 'Erreur',
      color: 'red',
      icon: '❌'
    },
    [{{ agent_name }}Status.DEGRADED]: {
      label: 'Dégradé',
      color: 'orange',
      icon: '⚠️'
    }
  };
  
  const config = statusConfig[status];
  const sizeClasses = {
    sm: 'px-2 py-1 text-xs',
    md: 'px-3 py-1.5 text-sm',
    lg: 'px-4 py-2 text-base'
  };
  
  return (
    <span 
      className={`inline-flex items-center rounded-full ${sizeClasses[size]} bg-${config.color}-100 text-${config.color}-800`}
      role="status"
      aria-label={`Statut: ${config.label}`}
    >
      <span className="mr-2" aria-hidden="true">{config.icon}</span>
      {config.label}
    </span>
  );
};

