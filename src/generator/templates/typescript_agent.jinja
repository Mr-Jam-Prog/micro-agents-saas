/**
 * Génère une clé de cache à partir des données d'entrée
 */
const generateCacheKey = (input: {{ agent_name }}Input): string => {
  const inputString = JSON.stringify(input, (key, value) => {
    // Exclure les champs temporaires et les métadonnées volatiles
    if (key === 'metadata' || key === 'context' || key.startsWith('_')) {
      return undefined;
    }
    return value;
  });
  
  // Utiliser un hash simple pour la performance
  let hash = 0;
  for (let i = 0; i < inputString.length; i++) {
    const char = inputString.charCodeAt(i);
    hash = ((hash << 5) - hash) + char;
    hash = hash & hash; // Convertir en entier 32-bit
  }
  
  return `{{ agent_name_snake }}_${hash.toString(36)}`;
};

/**
 * Valide les données d'entrée
 */
const validate{{ agent_name }}Input = (input: unknown): ValidationResult<{{ agent_name }}Input> => {
  const errors: string[] = [];
  
  if (!input || typeof input !== 'object') {
    return {
      isValid: false,
      errors: ['Input must be an object'],
      data: null
    };
  }
  
  const typedInput = input as Partial<{{ agent_name }}Input>;
  
  // Validation des champs requis
  {% for field in input_fields %}
  {% if field.required %}
  if (typedInput.{{ field.name }} === undefined || typedInput.{{ field.name }} === null) {
    errors.push('{{ field.name }} is required');
  }
  {% endif %}
  {% endfor %}
  
  // Validation des types
  {% for field in input_fields %}
  if (typedInput.{{ field.name }} !== undefined && typedInput.{{ field.name }} !== null) {
    {% if field.typescript_type.includes('string') %}
    if (typeof typedInput.{{ field.name }} !== 'string') {
      errors.push('{{ field.name }} must be a string');
    }
    {% elif field.typescript_type.includes('number') %}
    if (typeof typedInput.{{ field.name }} !== 'number') {
      errors.push('{{ field.name }} must be a number');
    }
    {% elif field.typescript_type.includes('boolean') %}
    if (typeof typedInput.{{ field_name }} !== 'boolean') {
      errors.push('{{ field.name }} must be a boolean');
    }
    {% elif field.typescript_type.includes('Array') %}
    if (!Array.isArray(typedInput.{{ field.name }})) {
      errors.push('{{ field.name }} must be an array');
    }
    {% elif field.typescript_type.includes('Record') or field.typescript_type.includes('object') %}
    if (typeof typedInput.{{ field.name }} !== 'object' || Array.isArray(typedInput.{{ field.name }})) {
      errors.push('{{ field.name }} must be an object');
    }
    {% endif %}
  }
  {% endfor %}
  
  return {
    isValid: errors.length === 0,
    errors,
    data: errors.length === 0 ? typedInput as {{ agent_name }}Input : null
  };
};

/**
 * Masque les données sensibles pour le logging
 */
const maskSensitiveData = <T>(data: T): T => {
  if (typeof data !== 'object' || data === null) {
    return data;
  }
  
  const masked = JSON.parse(JSON.stringify(data)) as Record<string, unknown>;
  const sensitiveKeys = ['password', 'token', 'secret', 'key', 'creditCard', 'ssn'];
  
  const maskRecursive = (obj: Record<string, unknown>): void => {
    for (const key in obj) {
      if (sensitiveKeys.some(sk => key.toLowerCase().includes(sk))) {
        obj[key] = '***MASKED***';
      } else if (typeof obj[key] === 'object' && obj[key] !== null) {
        maskRecursive(obj[key] as Record<string, unknown>);
      }
    }
  };
  
  maskRecursive(masked);
  return masked as T;
};

/**
 * Décorateur pour instrumenter les méthodes
 */
function instrumentMethod<T extends (...args: any[]) => any>(
  target: object,
  propertyKey: string,
  descriptor: TypedPropertyDescriptor<T>
): TypedPropertyDescriptor<T> {
  const originalMethod = descriptor.value!;
  
  descriptor.value = async function(this: any, ...args: Parameters<T>): Promise<ReturnType<T>> {
    const startTime = performance.now();
    const methodName = `${target.constructor.name}.${propertyKey}`;
    
    try {
      trackMetrics('method_call', { method: methodName });
      const result = await originalMethod.apply(this, args);
      const duration = performance.now() - startTime;
      
      trackMetrics('method_success', { 
        method: methodName, 
        duration 
      });
      
      if (duration > 1000) { // Seuil de performance
        console.warn(`Slow method detected: ${methodName} took ${duration.toFixed(2)}ms`);
      }
      
      return result;
    } catch (error) {
      const duration = performance.now() - startTime;
      trackMetrics('method_error', { 
        method: methodName, 
        duration,
        error: error instanceof Error ? error.message : String(error)
      });
      throw error;
    }
  } as T;
  
  return descriptor;
}

