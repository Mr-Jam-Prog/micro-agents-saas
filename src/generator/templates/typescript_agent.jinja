/**
 * Hook React pour utiliser l'agent
 */
export const use{{ agent_name }} = (): Use{{ agent_name }}Return => {
  const agent = useContext({{ agent_name }}Context);
  const [state, setState] = useState<Omit<{{ agent_name }}State, 'cacheStats'>>({
    status: {{ agent_name }}Status.IDLE,
    data: null,
    error: null,
    lastUpdated: new Date(),
    executionCount: 0
  });
  const [cacheStats, setCacheStats] = useState<{{ agent_name }}State['cacheStats']>({
    hits: 0,
    misses: 0,
    size: 0
  });
  
  if (!agent) {
    throw new Error('use{{ agent_name }} must be used within a {{ agent_name }}Provider');
  }
  
  // Écouter les changements d'état
  useEffect(() => {
    const unsubscribeStatus = agent.on('status-change', (status) => {
      setState(prev => ({ ...prev, status }));
    });
    
    const unsubscribeSuccess = agent.on('execution-success', ({ output }) => {
      setState(prev => ({
        ...prev,
        status: {{ agent_name }}Status.SUCCESS,
        data: output,
        error: null,
        lastUpdated: new Date(),
        executionCount: prev.executionCount + 1
      }));
    });
    
    const unsubscribeError = agent.on('execution-error', ({ error }) => {
      setState(prev => ({
        ...prev,
        status: {{ agent_name }}Status.ERROR,
        error,
        lastUpdated: new Date()
      }));
    });
    
    const unsubscribeCache = agent.on('cache-hit', () => {
      setCacheStats(prev => ({ ...prev, hits: prev.hits + 1 }));
    });
    
    return () => {
      unsubscribeStatus();
      unsubscribeSuccess();
      unsubscribeError();
      unsubscribeCache();
    };
  }, [agent]);
  
  // Mémoïser les valeurs dérivées
  const isLoading = useMemo(() => 
    state.status === {{ agent_name }}Status.LOADING || 
    state.status === {{ agent_name }}Status.PROCESSING, 
    [state.status]
  );
  
  const isError = useMemo(() => 
    state.status === {{ agent_name }}Status.ERROR, 
    [state.status]
  );
  
  const isSuccess = useMemo(() => 
    state.status === {{ agent_name }}Status.SUCCESS, 
    [state.status]
  );
  
  // Actions
  const execute = useCallback(async (
    input: {{ agent_name }}Input,
    options?: {{ agent_name }}ExecutionOptions
  ) => {
    try {
      await agent.execute(input, options);
    } catch (error) {
      // L'erreur est déjà gérée par les écouteurs d'événements
      console.error('Execution failed:', error);
    }
  }, [agent]);
  
  const reset = useCallback(() => {
    agent.reset();
    setState({
      status: {{ agent_name }}Status.IDLE,
      data: null,
      error: null,
      lastUpdated: new Date(),
      executionCount: 0
    });
    setCacheStats({
      hits: 0,
      misses: 0,
      size: 0
    });
  }, [agent]);
  
  const refresh = useCallback(async () => {
    try {
      await agent.refresh();
    } catch (error) {
      console.error('Refresh failed:', error);
    }
  }, [agent]);
  
  return {
    // État
    status: state.status,
    data: state.data,
    error: state.error,
    isLoading,
    isError,
    isSuccess,
    
    // Actions
    execute: useMemoizedFn(execute),
    reset: useMemoizedFn(reset),
    refresh: useMemoizedFn(refresh),
    
    // Métadonnées
    executionCount: state.executionCount,
    lastUpdated: state.lastUpdated,
    cacheStats
  };
};

/**
 * Composant React avec gestion d'erreurs
 */
export const {{ agent_name }}Component: React.FC<{
  input: {{ agent_name }}Input;
  onSuccess?: (output: {{ agent_name }}Output) => void;
  onError?: (error: Error) => void;
  children?: (props: Use{{ agent_name }}Return) => React.ReactNode;
}> = ({ input, onSuccess, onError, children }) => {
  const agent = use{{ agent_name }}();
  
  // Exécuter automatiquement quand l'input change
  useEffect(() => {
    if (input) {
      agent.execute(input).then(() => {
        if (agent.data && onSuccess) {
          onSuccess(agent.data);
        }
      }).catch((error) => {
        if (onError) {
          onError(error);
        }
      });
    }
  }, [input, agent, onSuccess, onError]);
  
  return (
    <ErrorBoundary
      fallback={<div>Une erreur est survenue</div>}
      onError={onError}
    >
      {children ? children(agent) : (
        <div>
          {agent.isLoading && <div>Chargement...</div>}
          {agent.isError && <div>Erreur: {agent.error?.message}</div>}
          {agent.isSuccess && <div>Succès!</div>}
        </div>
      )}
    </ErrorBoundary>
  );
};
