    async def test_scenario(
        self,
        scenario_name: str,
        test_input: Dict[str, Any],
        expected_output: Optional[Dict[str, Any]] = None
    ) -> Dict[str, Any]:
        """
        Exécute un scénario de test.
        
        Args:
            scenario_name: Nom du scénario
            test_input: Données de test
            expected_output: Sortie attendue (pour validation)
            
        Returns:
            Résultats du test
        """
        test_id = str(uuid.uuid4())
        start_time = time.time()
        
        self.logger.info(
            "Début du scénario de test",
            extra={
                "test_id": test_id,
                "scenario": scenario_name,
                "input_hash": hashlib.md5(
                    json.dumps(test_input).encode()
                ).hexdigest()[:8]
            }
        )
        
        try:
            # Exécution
            result = await self.execute(test_input)
            
            # Validation si sortie attendue fournie
            validation_result = None
            if expected_output:
                validation_result = self._validate_test_result(
                    result, expected_output, scenario_name
                )
            
            test_result = {
                "test_id": test_id,
                "scenario": scenario_name,
                "status": "passed",
                "execution_time_seconds": time.time() - start_time,
                "result": result,
                "validation": validation_result,
                "timestamp": datetime.utcnow().isoformat()
            }
            
            self.logger.info(
                "Test réussi",
                extra={
                    "test_id": test_id,
                    "scenario": scenario_name,
                    "execution_time": test_result["execution_time_seconds"]
                }
            )
            
            return test_result
            
        except Exception as e:
            test_result = {
                "test_id": test_id,
                "scenario": scenario_name,
                "status": "failed",
                "error": str(e),
                "error_type": type(e).__name__,
                "execution_time_seconds": time.time() - start_time,
                "timestamp": datetime.utcnow().isoformat()
            }
            
            self.logger.error(
                "Test échoué",
                extra={
                    "test_id": test_id,
                    "scenario": scenario_name,
                    "error": str(e)
                },
                exc_info=True
            )
            
            return test_result
    
    def _validate_test_result(
        self,
        actual: {{ primary_output_model }},
        expected: Dict[str, Any],
        scenario_name: str
    ) -> Dict[str, Any]:
        """
        Valide les résultats d'un test.
        
        Args:
            actual: Résultat actuel
            expected: Résultat attendu
            scenario_name: Nom du scénario
            
        Returns:
            Résultats de validation
        """
        validation_errors = []
        
        # Validation des champs critiques
        {% for validation_field in test_validation_fields %}
        if "{{ validation_field }}" in expected:
            actual_value = actual.{{ validation_field }}
            expected_value = expected["{{ validation_field }}"]
            
            {% if validation_field == 'anomalies' %}
            # Validation spéciale pour les anomalies
            if len(actual_value) != len(expected_value):
                validation_errors.append({
                    "field": "{{ validation_field }}",
                    "issue": f"Nombre d'anomalies incorrect: {len(actual_value)} au lieu de {len(expected_value)}",
                    "scenario": scenario_name
                })
            {% else %}
            if actual_value != expected_value:
                validation_errors.append({
                    "field": "{{ validation_field }}",
                    "issue": f"Valeur incorrecte: {actual_value} au lieu de {expected_value}",
                    "scenario": scenario_name
                })
            {% endif %}
        {% endfor %}
        
        return {
            "is_valid": len(validation_errors) == 0,
            "errors": validation_errors,
            "checked_fields": {{ test_validation_fields|tojson }},
            "scenario": scenario_name
        }
    
    @classmethod
    def run_test_suite(cls, test_cases: List[Dict[str, Any]]) -> Dict[str, Any]:
        """
        Exécute une suite de tests.
        
        Args:
            test_cases: Liste des cas de test
            
        Returns:
            Résumé des tests
        """
        results = {
            "total": len(test_cases),
            "passed": 0,
            "failed": 0,
            "scenarios": {},
            "start_time": datetime.utcnow().isoformat()
        }
        
        agent = cls(config={"environment": "testing"})
        
        for test_case in test_cases:
            scenario_name = test_case["name"]
            
            # Exécution du test (simplifié - en réalité async)
            try:
                # Ici, on appellerait agent.test_scenario de manière asynchrone
                test_result = {
                    "status": "simulated",
                    "scenario": scenario_name
                }
                
                if test_result.get("status") == "passed":
                    results["passed"] += 1
                else:
                    results["failed"] += 1
                
                results["scenarios"][scenario_name] = test_result
                
            except Exception as e:
                results["failed"] += 1
                results["scenarios"][scenario_name] = {
                    "status": "error",
                    "error": str(e)
                }
        
        results["end_time"] = datetime.utcnow().isoformat()
        results["success_rate"] = (
            results["passed"] / results["total"] * 100
            if results["total"] > 0 else 0
        )
        
        return results

