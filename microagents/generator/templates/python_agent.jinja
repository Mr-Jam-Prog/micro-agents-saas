            return {
                "ml_predictions": prediction,
                "ml_interpretation": interpreted,
                "ml_confidence": prediction.get("confidence", 0.0),
                "ml_features_used": list(features.keys())
            }
            
        except Exception as e:
            self.logger.error(
                "Erreur dans la logique ML",
                extra={
                    "error": str(e),
                    "input_hash": hashlib.md5(
                        json.dumps(processed_input).encode()
                    ).hexdigest()[:8]
                },
                exc_info=True
            )
            
            # Fallback vers des règles statistiques
            return await self._fallback_statistical_logic(processed_input)
