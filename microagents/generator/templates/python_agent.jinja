class MicroAgentError(Exception):
    """Exception de base pour tous les agents MicroAgents"""
    def __init__(self, message: str, code: str = "AGENT_ERROR", severity: SeverityLevel = SeverityLevel.ERROR):
        self.message = message
        self.code = code
        self.severity = severity
        super().__init__(self.message)
    
    def to_dict(self) -> Dict[str, Any]:
        """Convertit l'exception en dictionnaire pour le logging"""
        return {
            "error_code": self.code,
            "message": self.message,
            "severity": self.severity.value,
            "timestamp": datetime.utcnow().isoformat(),
            "agent": "{{ agent_name }}"
        }


class ValidationError(MicroAgentError):
    """Erreur de validation des données d'entrée"""
    def __init__(self, message: str, field: Optional[str] = None):
        super().__init__(message, code="VALIDATION_ERROR")
        self.field = field


class ConfigurationError(MicroAgentError):
    """Erreur de configuration de l'agent"""
    def __init__(self, message: str):
        super().__init__(message, code="CONFIGURATION_ERROR")


class DependencyError(MicroAgentError):
    """Erreur de dépendance externe"""
    def __init__(self, message: str, dependency: str):
        super().__init__(message, code="DEPENDENCY_ERROR")
        self.dependency = dependency


class SecurityError(MicroAgentError):
    """Erreur de sécurité"""
    def __init__(self, message: str):
        super().__init__(message, code="SECURITY_ERROR", severity=SeverityLevel.CRITICAL)


class BusinessRuleError(MicroAgentError):
    """Violation d'une règle métier"""
    def __init__(self, message: str, rule_name: str):
        super().__init__(message, code="BUSINESS_RULE_ERROR")
        self.rule_name = rule_name


