async def example_usage() -> None:
    """
    Exemple d'utilisation de l'agent.
    
    Cette fonction démontre comment utiliser l'agent dans différents scénarios.
    """
    print(f"=== Exemple d'utilisation: {{ agent_name }} ===")
    
    # 1. Initialisation
    config = {
        "environment": "development",
        "logging": {"level": "DEBUG"},
        "security": {"audit_logging_enabled": True}
    }
    
    agent = {{ agent_class_name }}(config=config)
    print(f"✅ Agent initialisé: {agent.AGENT_NAME} v{agent.AGENT_VERSION}")
    
    # 2. Vérification de santé
    health = await agent.health_check()
    print(f"✅ Santé: {health['overall_status']}")
    print(f"   Uptime: {health['uptime_seconds']:.1f}s")
    
    # 3. Exécution simple
    sample_input = {{ sample_input|tojson }}
    
    try:
        result = await agent.execute(sample_input)
        print(f"✅ Exécution réussie")
        print(f"   Execution ID: {result.execution_id}")
        print(f"   Temps de traitement: {result.performance.processing_time_ms}ms")
        
        {% if has_anomaly_detection %}
        if result.anomalies:
            print(f"   Anomalies détectées: {len(result.anomalies)}")
            for anomaly in result.anomalies[:3]:  # Affiche les 3 premières
                print(f"    - {anomaly.rule}: {anomaly.severity}")
        {% endif %}
        
    except Exception as e:
        print(f"❌ Erreur d'exécution: {str(e)}")
    
    # 4. Batch execution
    batch_input = [sample_input] * 3
    batch_results = await agent.batch_execute(batch_input, max_concurrency=2)
    print(f"✅ Batch execution: {len(batch_results)} résultats")
    
    # 5. Métriques
    metrics = agent.get_metrics()
    print(f"✅ Métriques disponibles: {len(metrics)} bytes")


def run_tests() -> None:
    """
    Exécute les tests de l'agent.
    """
    print(f"=== Tests: {{ agent_name }} ===")
    
    test_cases = {{ test_cases|tojson }}
    
    results = {{ agent_class_name }}.run_test_suite(test_cases)
    
    print(f"Total: {results['total']}")
    print(f"Réussis: {results['passed']}")
    print(f"Échoués: {results['failed']}")
    print(f"Taux de succès: {results['success_rate']:.1f}%")
    
    for scenario, result in results["scenarios"].items():
        status = "✅" if result.get("status") in ["passed", "simulated"] else "❌"
        print(f"  {status} {scenario}")


