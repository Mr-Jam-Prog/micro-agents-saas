if __name__ == "__main__":
    """
    Point d'entrée principal pour l'exécution en standalone.
    
    Usage:
        python {{ agent_name_snake }}.py --help
        python {{ agent_name_snake }}.py --execute --input input.json
        python {{ agent_name_snake }}.py --test
        python {{ agent_name_snake }}.py --health
    """
    import argparse
    import sys
    
    parser = argparse.ArgumentParser(
        description="{{ description }}",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    
    parser.add_argument(
        "--execute",
        action="store_true",
        help="Exécute l'agent avec les données d'entrée"
    )
    parser.add_argument(
        "--input",
        type=str,
        help="Fichier JSON contenant les données d'entrée"
    )
    parser.add_argument(
        "--test",
        action="store_true",
        help="Exécute la suite de tests"
    )
    parser.add_argument(
        "--health",
        action="store_true",
        help="Vérifie la santé de l'agent"
    )
    parser.add_argument(
        "--config",
        type=str,
        help="Fichier de configuration JSON"
    )
    parser.add_argument(
        "--metrics",
        action="store_true",
        help="Affiche les métriques Prometheus"
    )
    parser.add_argument(
        "--version",
        action="store_true",
        help="Affiche la version de l'agent"
    )
    
    args = parser.parse_args()
    
    if args.version:
        print(f"{{ agent_name }} v{{ version }}")
        print(f"Généré le: {{ generation_date }}")
        sys.exit(0)
    
    if not any([args.execute, args.test, args.health, args.metrics]):
        parser.print_help()
        sys.exit(1)
    
    # Chargement de la configuration
    config = {}
    if args.config:
        try:
            with open(args.config, 'r') as f:
                config = json.load(f)
        except Exception as e:
            print(f"❌ Erreur chargement configuration: {str(e)}")
            sys.exit(1)
    
    # Initialisation de l'agent
    agent = {{ agent_class_name }}(config=config)
    
    async def main():
        if args.health:
            health = await agent.health_check()
            print(json.dumps(health, indent=2))
        
        elif args.metrics:
            metrics = agent.get_metrics()
            print(metrics.decode())
        
        elif args.test:
            run_tests()
        
        elif args.execute:
            if not args.input:
                print("❌ L'option --input est requise avec --execute")
                sys.exit(1)
            
            try:
                with open(args.input, 'r') as f:
                    input_data = json.load(f)
            except Exception as e:
                print(f"❌ Erreur chargement input: {str(e)}")
                sys.exit(1)
            
            try:
                result = await agent.execute(input_data)
                print(json.dumps(result.dict(), indent=2))
            except Exception as e:
                print(f"❌ Erreur d'exécution: {str(e)}")
                sys.exit(1)
    
    # Exécution asynchrone
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\n🛑 Interrompu par l'utilisateur")
        sys.exit(0)
    except Exception as e:
        print(f"❌ Erreur inattendue: {str(e)}")
        sys.exit(1)

