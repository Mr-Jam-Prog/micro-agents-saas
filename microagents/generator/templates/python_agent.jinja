    ) -> {{ primary_output_model }}:
        """
        Méthode principale d'exécution de l'agent.
        
        Cette méthode implémente la logique métier principale de l'agent.
        Elle est instrumentée avec monitoring, validation et audit.
        
        Args:
            input_data: Données d'entrée validées
            context: Contexte d'exécution additionnel
            
        Returns:
            Résultat du traitement
            
        Raises:
            ValidationError: Si les données d'entrée sont invalides
            BusinessRuleError: Si une règle métier est violée
            MicroAgentError: Pour toutes les autres erreurs
        """
        self.status = AgentStatus.PROCESSING
        execution_id = str(uuid.uuid4())
        
        self.logger.info(
            "Début de l'exécution",
            extra={
                "execution_id": execution_id,
                "input_type": type(input_data).__name__,
                "context_keys": list(context.keys()) if context else []
            }
        )
        
        try:
            # 1. Prétraitement
            processed_input = await self._preprocess_input(input_data, context)
            
            # 2. Application des règles métier
            business_rules_result = await self._apply_business_rules(processed_input)
            
            # 3. Exécution de la logique principale
            {% if has_ml_component %}
            # Logique avec composant ML
            ml_result = await self._apply_ml_logic(processed_input)
            intermediate_result = self._combine_results(business_rules_result, ml_result)
            {% else %}
            # Logique purement basée sur les règles
            intermediate_result = business_rules_result
            {% endif %}
            
            # 4. Post-traitement et validation
            final_result = await self._postprocess_result(intermediate_result)
            
            # 5. Génération du rapport
            output = self._generate_output(final_result, execution_id)
            
            # 6. Enregistrement des métriques
            self.metrics["processing_success"].inc()
            
            self.logger.info(
                "Exécution terminée avec succès",
                extra={
                    "execution_id": execution_id,
                    "processing_time": time.time() - self._start_time.timestamp(),
                    "result_size": len(str(output))
                }
            )
            
            return output
            
        except BusinessRuleError as e:
            self.metrics["processing_failure"].labels(error_type="business_rule").inc()
            self.logger.warning(
                "Règle métier violée",
                extra=e.to_dict()
            )
            raise
            
        except Exception as e:
            self.metrics["processing_failure"].labels(
                error_type=type(e).__name__
            ).inc()
            self.logger.error(
                "Erreur lors de l'exécution",
                extra={
                    "execution_id": execution_id,
                    "error": str(e),
                    "error_type": type(e).__name__
                },
                exc_info=True
            )
            raise MicroAgentError(f"Erreur d'exécution: {str(e)}")
            
        finally:
            self.status = AgentStatus.READY
    
    async def batch_execute(
        self,
        input_batch: List[Union[Dict[str, Any], {{ primary_input_model }}]],
        max_concurrency: Optional[int] = None
    ) -> List[{{ primary_output_model }}]:
        """
        Exécute l'agent en batch sur plusieurs entrées.
        
        Args:
            input_batch: Liste des données d'entrée
            max_concurrency: Nombre maximum d'exécutions concurrentes
            
        Returns:
            Liste des résultats
        """
        max_concurrency = max_concurrency or self.config["performance"]["batch_concurrency"]
        
        semaphore = asyncio.Semaphore(max_concurrency)
        
        async def process_with_semaphore(input_item):
            async with semaphore:
                return await self.execute(input_item)
        
        tasks = [process_with_semaphore(item) for item in input_batch]
        results = await asyncio.gather(*tasks, return_exceptions=True)
        
        # Traitement des exceptions
        successful_results = []
        errors = []
        
        for result in results:
            if isinstance(result, Exception):
                errors.append(result)
                self.logger.error("Échec de traitement batch", exc_info=result)
            else:
                successful_results.append(result)
        
        if errors:
            self.logger.warning(
                f"{len(errors)} erreurs dans le traitement batch",
                extra={"error_count": len(errors)}
            )
        
        return successful_results
    
    # =========================================================================
    # MÉTHODES DE PRÉTRAITEMENT
    # =========================================================================
    
    async def _preprocess_input(
        self,
        input_data: Union[Dict[str, Any], {{ primary_input_model }}],
        context: Optional[Dict[str, Any]] = None
    ) -> Dict[str, Any]:
        """
        Prétraite les données d'entrée.
        
        Args:
            input_data: Données d'entrée
            context: Contexte additionnel
            
        Returns:
            Données prétraitées
        """
        # Conversion en dict si nécessaire
        if isinstance(input_data, BaseModel):
            processed = input_data.dict()
        else:
            processed = input_data.copy()
        
        # Ajout du contexte
        if context:
            processed["_context"] = context
        
        # Normalisation des dates
        processed = self._normalize_dates(processed)
        
        # Validation supplémentaire
        if self.strict_validation:
            self._validate_preprocessed(processed)
        
        # Cache lookup
        cache_key = self._generate_cache_key(processed)
        cached_result = self._cache_get(cache_key)
        
        if cached_result:
            self.metrics["cache_hits"].inc()
            self.logger.debug("Résultat trouvé en cache", extra={"cache_key": cache_key})
            raise StopIteration(cached_result)  # Short-circuit pour cache hit
        
        self.metrics["cache_misses"].inc()
        
        return processed
    
    def _normalize_dates(self, data: Dict[str, Any]) -> Dict[str, Any]:
        """Normalise les dates dans les données."""
