    async def health_check(self) -> Dict[str, Any]:
        """
        Vérifie la santé de l'agent.
        
        Returns:
            Statut de santé détaillé
        """
        checks = {
            "agent_status": self.status.value,
            "timestamp": datetime.utcnow().isoformat(),
            "version": self.AGENT_VERSION,
            "uptime_seconds": (datetime.utcnow() - self._start_time).total_seconds()
        }
        
        # Vérification du cache
        checks["cache"] = {
            "size": self._cache_stats["size"],
            "hits": self._cache_stats["hits"],
            "misses": self._cache_stats["misses"],
            "hit_rate": (
                self._cache_stats["hits"] / (self._cache_stats["hits"] + self._cache_stats["misses"])
                if (self._cache_stats["hits"] + self._cache_stats["misses"]) > 0
                else 0
            )
        }
        
        # Vérification des dépendances
        checks["dependencies"] = await self._check_dependencies()
        
        # Métriques système
        checks["metrics"] = {
            "processing_success": self.metrics["processing_success"]._value.get(),
            "processing_failure": {
                label: self.metrics["processing_failure"]._value.get()
                for label in ["business_rule", "validation", "unknown"]
            },
            "active_requests": ACTIVE_REQUESTS._value.get()
        }
        
        # Détermination du statut global
        all_healthy = all(
            dep["status"] == "healthy"
            for dep in checks["dependencies"].values()
            if dep.get("required", True)
        )
        
        checks["overall_status"] = "healthy" if all_healthy else "degraded"
        
        # Mise à jour de la métrique Prometheus
        self.health_status.set(1 if checks["overall_status"] == "healthy" else 0)
        
        return checks
    
    async def _check_dependencies(self) -> Dict[str, Dict[str, Any]]:
        """
        Vérifie l'état des dépendances.
        
        Returns:
            Statut des dépendances
        """
        dependencies_status = {}
        
        {% for dep_name, dep_config in dependencies.items() %}
        # Vérification: {{ dep_name }}
        try:
            {% if dep_config.type == 'http' %}
            import aiohttp
            async with aiohttp.ClientSession() as session:
                async with session.get("{{ dep_config.health_check }}", timeout=5) as resp:
                    status = "healthy" if resp.status == 200 else "unhealthy"
            {% elif dep_config.type == 'database' %}
            # Vérification de connexion DB
            status = "healthy"  # À implémenter
            {% elif dep_config.type == 'cache' %}
            # Test de ping du cache
            status = "healthy" if self._cache else "unhealthy"
            {% else %}
            status = "unknown"
            {% endif %}
            
            dependencies_status["{{ dep_name }}"] = {
                "status": status,
                "type": "{{ dep_config.type }}",
                "required": {{ dep_config.required|lower }},
                "checked_at": datetime.utcnow().isoformat()
            }
        except Exception as e:
            dependencies_status["{{ dep_name }}"] = {
                "status": "unhealthy",
                "error": str(e),
                "type": "{{ dep_config.type }}",
                "required": {{ dep_config.required|lower }},
                "checked_at": datetime.utcnow().isoformat()
            }
        {% endfor %}
        
        return dependencies_status
    
