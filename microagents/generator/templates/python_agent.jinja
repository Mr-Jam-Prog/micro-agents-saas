    async def _apply_ml_logic(
        self,
        processed_input: Dict[str, Any]
    ) -> Dict[str, Any]:
        """
        Applique la logique d'apprentissage automatique.
        
        Args:
            processed_input: Données prétraitées
            
        Returns:
            Résultats ML
        """
        try:
            # Préparation des features
            features = self._extract_features(processed_input)
            
            # Prédiction avec le modèle
            prediction = await self._ml_model_predict(features)
            
            # Interprétation des résultats
