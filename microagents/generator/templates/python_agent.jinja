    def __init__(
        self,
        config: Optional[Dict[str, Any]] = None,
        logger: Optional[logging.Logger] = None,
        enable_monitoring: bool = True,
        strict_validation: bool = True
    ):
        """
        Initialise l'agent avec la configuration fournie.
        
