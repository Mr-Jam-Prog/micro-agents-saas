    async def _apply_business_rules(
        self,
        processed_input: Dict[str, Any]
    ) -> Dict[str, Any]:
        """
        Applique les règles métier configurées.
        
        Args:
            processed_input: Données prétraitées
            
        Returns:
            Résultat après application des règles
        """
        result = processed_input.copy()
        triggered_rules = []
        
        {% for rule in business_rules %}
        # Règle: {{ rule.name }}
        # {{ rule.description }}
        if {{ rule.condition }}:
            {% if rule.action == 'flag_anomaly' %}
            result["anomalies"].append({
                "rule": "{{ rule.name }}",
                "severity": "{{ rule.severity }}",
                "description": "{{ rule.description }}",
                "triggered_at": datetime.utcnow().isoformat()
            })
            {% elif rule.action == 'calculate_metric' %}
            result["metrics"]["{{ rule.metric_name }}"] = {{ rule.calculation }}
            {% elif rule.action == 'transform_data' %}
            result = self._apply_transformation(result, "{{ rule.transformation_name }}")
            {% endif %}
            triggered_rules.append("{{ rule.name }}")
            self.metrics["business_rules_triggered"].labels(rule_name="{{ rule.name }}").inc()
        {% endfor %}
        
        result["_metadata"]["triggered_rules"] = triggered_rules
        
        # Vérification des seuils critiques
        await self._check_critical_thresholds(result)
        
        return result
    
