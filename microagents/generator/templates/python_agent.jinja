    # =========================================================================
    # MÉTHODES DE GESTION DU CACHE
    # =========================================================================
    
    def _initialize_cache(self) -> None:
        """Initialise le système de cache."""
        # Pour des besoins simples, on utilise un dict en mémoire
        # Pour la production, remplacer par Redis ou similaire
        self._cache = {}
        self._cache_stats = {"hits": 0, "misses": 0, "size": 0}
    
    def _generate_cache_key(self, data: Dict[str, Any]) -> str:
        """
        Génère une clé de cache à partir des données.
        
        Args:
            data: Données à cacher
            
        Returns:
            Clé de cache
        """
        # Exclusion des champs temporaires
        cache_data = {
            k: v for k, v in data.items()
            if not k.startswith('_') and k not in ['timestamp', 'execution_id']
        }
        
        # Tri pour la cohérence
        sorted_data = json.dumps(cache_data, sort_keys=True)
        
        # Hash pour une clé fixe
        return f"{self.AGENT_NAME}:{hashlib.md5(sorted_data.encode(), usedforsecurity=False).hexdigest()}"
    
    def _cache_get(self, key: str) -> Optional[Any]:
        """
        Récupère une valeur du cache.
        
        Args:
            key: Clé de cache
            
        Returns:
            Valeur en cache ou None
        """
        if key in self._cache:
            entry = self._cache[key]
            if entry["expires_at"] > datetime.utcnow():
                self._cache_stats["hits"] += 1
                return entry["value"]
            else:
                # Expiré, on le supprime
                del self._cache[key]
                self._cache_stats["size"] -= 1
        
        self._cache_stats["misses"] += 1
        return None
    
    def _cache_set(
        self,
        key: str,
        value: Any,
        ttl: Optional[int] = None
    ) -> None:
        """
        Stocke une valeur dans le cache.
        
        Args:
            key: Clé de cache
            value: Valeur à stocker
            ttl: Time to live en secondes
        """
        ttl = ttl or self.config["performance"]["cache_ttl_seconds"]
        
        self._cache[key] = {
            "value": value,
            "expires_at": datetime.utcnow() + timedelta(seconds=ttl),
            "created_at": datetime.utcnow()
        }
        
        self._cache_stats["size"] += 1
        
        # Nettoyage du cache si nécessaire
        if len(self._cache) > self.config["performance"]["max_cache_size"]:
            self._clean_cache()
    
    def _clean_cache(self) -> None:
        """Nettoie le cache des entrées expirées."""
        now = datetime.utcnow()
        expired_keys = [
            k for k, v in self._cache.items()
            if v["expires_at"] <= now
        ]
        
        for key in expired_keys:
            del self._cache[key]
        
        self._cache_stats["size"] -= len(expired_keys)
        
        # Si toujours trop grand, on supprime les plus anciens
        if len(self._cache) > self.config["performance"]["max_cache_size"]:
            sorted_keys = sorted(
                self._cache.keys(),
                key=lambda k: self._cache[k]["created_at"]
            )
            
            keys_to_remove = sorted_keys[:len(self._cache) - self.config["performance"]["max_cache_size"]]
            for key in keys_to_remove:
                del self._cache[key]
            
            self._cache_stats["size"] -= len(keys_to_remove)
    
    # =========================================================================
    # MÉTHODES DE SÉCURITÉ
    # =========================================================================
    
    def _validate_configuration(self, config: Dict[str, Any]) -> None:
        """
        Valide la configuration de sécurité.
        
        Args:
            config: Configuration à valider
            
        Raises:
            ConfigurationError: Si la configuration est invalide
            SecurityError: Si des problèmes de sécurité sont détectés
        """
        security_config = config.get("security", {})
        
        # Vérification des clés de chiffrement
        if security_config.get("encryption_enabled", False):
            if not security_config.get("encryption_key"):
                raise ConfigurationError(
                    "Clé de chiffrement requise quand encryption_enabled=True"
                )
        
        # Validation des règles de sécurité
        required_security_rules = [
            "input_validation_enabled",
            "audit_logging_enabled"
        ]
        
        for rule in required_security_rules:
            if not security_config.get(rule, False):
                self.logger.warning(
                    f"Règle de sécurité désactivée: {rule}",
                    extra={"security_risk": "medium"}
                )
    
    def _encrypt_sensitive_data(self, data: str) -> str:
        """
        Chiffre les données sensibles.
        
        Args:
            data: Données sensibles à chiffrer
            
        Returns:
            Données chiffrées en base64
        """
        if not self.config["security"]["encryption_enabled"]:
            return data
        
        try:
            key = self.config["security"]["encryption_key"].encode()
            fernet = Fernet(key)
            return fernet.encrypt(data.encode()).decode()
        except Exception as e:
            raise SecurityError(f"Échec du chiffrement: {str(e)}")
    
    def _decrypt_sensitive_data(self, encrypted_data: str) -> str:
        """
        Déchiffre les données sensibles.
        
        Args:
            encrypted_data: Données chiffrées
            
        Returns:
            Données déchiffrées
        """
        if not self.config["security"]["encryption_enabled"]:
            return encrypted_data
        
        try:
            key = self.config["security"]["encryption_key"].encode()
            fernet = Fernet(key)
            return fernet.decrypt(encrypted_data.encode()).decode()
        except Exception as e:
            raise SecurityError(f"Échec du déchiffrement: {str(e)}")
    
    def _sanitize_log_data(self, data: Dict[str, Any]) -> Dict[str, Any]:
        """
        Nettoie les données sensibles pour le logging.
        
        Args:
            data: Données à nettoyer
            
        Returns:
            Données nettoyées
        """
        sanitized = data.copy()
        
        # Masquage des champs sensibles
        sensitive_fields = [
            "password", "token", "secret", "key", "credit_card",
            "ssn", "phone", "email"
        ]
        
        for key in list(sanitized.keys()):
            if any(sensitive in key.lower() for sensitive in sensitive_fields):
                sanitized[key] = "***MASKED***"
        
        return sanitized
    
