def instrument_processing(func: Callable) -> Callable:
    """
    Décorateur pour instrumenter le temps de traitement.
    Ajoute des métriques Prometheus et du logging.
    """
    @wraps(func)
    async def wrapper(self, *args, **kwargs):
        start_time = time.time()
        ACTIVE_REQUESTS.inc()
        
        try:
            result = await func(self, *args, **kwargs)
            processing_time = time.time() - start_time
            PROCESSING_TIME.observe(processing_time)
            
            # Log du temps de traitement si > seuil
            if processing_time > {{ performance.latency_threshold_warning }}:
                self.logger.warning(
                    f"Traitement lent détecté: {processing_time:.3f}s",
                    extra={
                        "processing_time": processing_time,
                        "threshold": {{ performance.latency_threshold_warning }}
                    }
                )
            
            return result
        except Exception as e:
            ERROR_COUNT.labels(error_type=type(e).__name__).inc()
            raise
        finally:
            ACTIVE_REQUESTS.dec()
    
    return wrapper


def validate_input(schema_name: str) -> Callable:
    """
    Décorateur pour valider les données d'entrée avec JSON Schema.
    """
    def decorator(func: Callable) -> Callable:
        @wraps(func)
        async def wrapper(self, input_data: Dict[str, Any], *args, **kwargs):
            try:
                # Validation avec Pydantic
                validation_model = globals().get(schema_name)
                if validation_model:
                    validated_data = validation_model(**input_data)
                    validated_input = validated_data.dict()
                else:
                    # Fallback: validation JSON Schema
                    schema = self.config.get("validation_schemas", {}).get(schema_name)
                    if schema:
                        json_validate(instance=input_data, schema=schema)
                    validated_input = input_data
                
                self.logger.debug(f"Validation réussie pour {schema_name}")
                return await func(self, validated_input, *args, **kwargs)
                
            except pydantic.ValidationError as e:
                raise ValidationError(
                    f"Erreur de validation Pydantic: {str(e)}",
                    field=e.errors()[0].get("loc")[0] if e.errors() else None
                )
            except Exception as e:
                raise ValidationError(f"Erreur de validation: {str(e)}")
        
        return wrapper
    return decorator


def retry_on_failure(
    max_retries: int = 3,
    delay: float = 1.0,
    backoff: float = 2.0,
    exceptions: Tuple = (Exception,)
) -> Callable:
    """
    Décorateur pour réessayer en cas d'échec avec backoff exponentiel.
    """
    def decorator(func: Callable) -> Callable:
        @wraps(func)
        async def wrapper(*args, **kwargs):
            last_exception = None
            
            for attempt in range(max_retries + 1):
                try:
                    if attempt > 0:
                        wait_time = delay * (backoff ** (attempt - 1))
                        await asyncio.sleep(wait_time)
                    
                    return await func(*args, **kwargs)
                    
                except exceptions as e:
                    last_exception = e
                    if attempt == max_retries:
                        break
                    logging.warning(f"Tentative {attempt + 1} échouée: {str(e)}")
            
            raise last_exception
        
        return wrapper
    return decorator


def audit_trail(action: str) -> Callable:
    """
    Décorateur pour enregistrer une trace d'audit.
    """
    def decorator(func: Callable) -> Callable:
        @wraps(func)
        async def wrapper(self, *args, **kwargs):
            audit_id = str(uuid.uuid4())
            start_time = datetime.utcnow()
            
            audit_data = {
                "audit_id": audit_id,
                "action": action,
                "agent": self.__class__.__name__,
                "start_time": start_time.isoformat(),
                "user_context": getattr(self, 'user_context', {}),
                "input_hash": hashlib.sha256(
                    json.dumps(args[0] if args else kwargs).encode()
                ).hexdigest()[:16]
            }
            
            try:
                result = await func(self, *args, **kwargs)
                
                audit_data.update({
                    "status": "success",
                    "end_time": datetime.utcnow().isoformat(),
                    "result_hash": hashlib.sha256(
                        json.dumps(result).encode()
                    ).hexdigest()[:16] if result else None
                })
                
                self._log_audit(audit_data)
                return result
                
            except Exception as e:
                audit_data.update({
                    "status": "failure",
                    "end_time": datetime.utcnow().isoformat(),
                    "error": str(e),
                    "error_type": type(e).__name__
                })
                
                self._log_audit(audit_data)
                raise
        
        return wrapper
    return decorator


