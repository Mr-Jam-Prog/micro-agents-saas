    async def _postprocess_result(
        self,
        intermediate_result: Dict[str, Any]
    ) -> Dict[str, Any]:
        """
        Post-traite les résultats intermédiaires.
        
        Args:
            intermediate_result: Résultat après logique métier/ML
            
        Returns:
            Résultat final post-traité
        """
        result = intermediate_result.copy()
        
        # Nettoyage des données temporaires
        if "_context" in result:
            del result["_context"]
        
        # Formatage des nombres
        result = self._format_numbers(result)
        
        # Ajout de métadonnées
        result["_metadata"].update({
            "processing_completed_at": datetime.utcnow().isoformat(),
            "agent_version": self.AGENT_VERSION,
            "processing_duration_ms": int(
                (datetime.utcnow() - self._start_time).total_seconds() * 1000
            )
        })
        
        # Cache le résultat
        cache_key = self._generate_cache_key(intermediate_result)
        self._cache_set(cache_key, result, ttl=self.config["performance"]["cache_ttl_seconds"])
        
        return result
    
