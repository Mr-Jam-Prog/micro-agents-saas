            config: Configuration de l'agent (dict)
            logger: Instance de logger personnalisée
            enable_monitoring: Active les métriques Prometheus
            strict_validation: Active la validation stricte des entrées
        """
        self._start_time = datetime.utcnow()
        self.status = AgentStatus.INITIALIZING
        
        # Configuration
        self.config = self._load_configuration(config or {})
        
        # Logging
        self.logger = logger or self._setup_logging()
        
        # Validation
        self.strict_validation = strict_validation
        
        # Monitoring
        self.enable_monitoring = enable_monitoring
        if enable_monitoring:
            self._setup_monitoring()
        
        # Cache et état
        self._cache = {}
        self._state = {}
        
        # Dépendances
        self._dependencies = {}
        
        # Initialisation
        self._initialize_agent()
        
        self.status = AgentStatus.READY
        self.logger.info(
            f"Agent {self.AGENT_NAME} v{self.AGENT_VERSION} initialisé avec succès",
            extra={
                "agent_id": self.AGENT_ID,
                "status": self.status.value,
                "config_hash": hashlib.md5(
                    json.dumps(self.config, sort_keys=True).encode()
                ).hexdigest()[:8]
            }
        )
    
    def _load_configuration(self, user_config: Dict[str, Any]) -> Dict[str, Any]:
        """
        Charge et valide la configuration.
        
        Args:
            user_config: Configuration utilisateur
            
        Returns:
            Configuration validée et enrichie
        """
        default_config = {
            # Configuration de base
            "agent": {
                "name": self.AGENT_NAME,
                "version": self.AGENT_VERSION,
                "environment": "production",
                "region": "eu-west-1"
