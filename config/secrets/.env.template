# =============================================================================
# MicroAgents Platform - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL
# =============================================================================
# Security: All secrets should be rotated regularly
# Validation: Run `scripts/validate_env.py` after configuration
# =============================================================================

# ==================== APPLICATION CONFIGURATION ====================

# Application Environment
# -----------------------
# Environment: development, staging, production
# Required: Yes
# Example: ENVIRONMENT=development
ENVIRONMENT=development

# Application Name
# ----------------
# Name used in logs and monitoring
# Required: Yes
# Default: MicroAgents Platform
APP_NAME=MicroAgents Platform

# Application Version
# -------------------
# Semantic version (from git tag or package version)
# Required: Yes
# Example: APP_VERSION=1.0.0
APP_VERSION=1.0.0

# Debug Mode
# ----------
# Enable debug features (DO NOT enable in production)
# Required: Yes
# Values: true, false
# Default: false
# Production: Must be false
DEBUG=false

# Log Level
# ---------
# Logging verbosity
# Required: Yes
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# Production: INFO or WARNING
LOG_LEVEL=INFO

# ==================== DATABASE CONFIGURATION ====================

# Primary Database URL
# --------------------
# PostgreSQL connection string
# Required: Yes
# Format: postgresql://user:password@host:port/database
# Example (local): postgresql://postgres:postgres@localhost:5432/microagents
# Example (AWS RDS): postgresql://user:pass@rds-instance.us-east-1.rds.amazonaws.com:5432/microagents
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/microagents

# Database Pool Size
# ------------------
# Maximum number of database connections in pool
# Required: No
# Default: 20
# Production: 20-50 based on instance size
DATABASE_POOL_SIZE=20

# Database Max Overflow
# ---------------------
# Maximum overflow connections when pool is exhausted
# Required: No
# Default: 10
DATABASE_MAX_OVERFLOW=10

# Database SSL Mode
# -----------------
# SSL mode for database connections
# Required: No
# Values: disable, allow, prefer, require, verify-ca, verify-full
# Default: prefer
# Production: verify-full
DATABASE_SSL_MODE=prefer

# Database Timeout
# ----------------
# Database query timeout in seconds
# Required: No
# Default: 30
DATABASE_TIMEOUT=30

# Database Echo SQL
# -----------------
# Log all SQL queries (DO NOT enable in production)
# Required: No
# Default: false
# Warning: Security risk if enabled in production
DATABASE_ECHO_SQL=false

# ==================== CACHE CONFIGURATION ====================

# Redis URL
# ---------
# Redis connection string for caching and queues
# Required: Yes (except for development with memory cache)
# Format: redis://:password@host:port/db
# Example (local): redis://localhost:6379/0
# Example (ElastiCache): redis://:password@cache-cluster.redis.amazonaws.com:6379/0
REDIS_URL=redis://localhost:6379/0

# Redis Password
# --------------
# Redis AUTH password (if not in URL)
# Required: Only if not in REDIS_URL
REDIS_PASSWORD=

# Redis SSL
# ---------
# Enable SSL for Redis connections
# Required: No
# Default: false
# Production: true (for managed services)
REDIS_SSL=false

# Redis Cluster Mode
# ------------------
# Enable Redis cluster mode
# Required: No
# Default: false
# Production: true for cluster deployments
REDIS_CLUSTER=false

# Cache Default Timeout
# ---------------------
# Default cache timeout in seconds
# Required: No
# Default: 300 (5 minutes)
CACHE_DEFAULT_TIMEOUT=300

# ==================== SECURITY & AUTHENTICATION ====================

# JWT Secret Key
# --------------
# Secret key for JWT token signing and verification
# Required: Yes
# Length: Minimum 32 characters
# Production: Must be strong, randomly generated
# Generation: `openssl rand -hex 32`
JWT_SECRET_KEY=changeme-in-production-32-char-minimum-secret

# JWT Algorithm
# -------------
# Algorithm for JWT token signing
# Required: No
# Values: HS256, HS384, HS512, RS256, RS384, RS512
# Default: HS256
# Production: RS256 (asymmetric)
JWT_ALGORITHM=HS256

# JWT Public Key (for RS* algorithms)
# ------------------------------------
# Public key for JWT verification (RSA algorithms only)
# Required: Only if using RS256/RS384/RS512
JWT_PUBLIC_KEY=

# JWT Private Key (for RS* algorithms)
# -------------------------------------
# Private key for JWT signing (RSA algorithms only)
# Required: Only if using RS256/RS384/RS512
JWT_PRIVATE_KEY=

# JWT Token Expiry
# ----------------
# JWT token expiration time in minutes
# Required: No
# Default: 15
# Security: Short-lived tokens recommended
JWT_TOKEN_EXPIRY=15

# Refresh Token Expiry
# --------------------
# Refresh token expiration time in days
# Required: No
# Default: 7
REFRESH_TOKEN_EXPIRY=7

# Encryption Key
# --------------
# Key for encrypting sensitive data at rest
# Required: Yes
# Length: 32 characters for AES-256
# Generation: `openssl rand -hex 32`
ENCRYPTION_KEY=changeme-in-production-32-char-encryption-key

# Password Hash Rounds
# --------------------
# Number of bcrypt rounds for password hashing
# Required: No
# Default: 12
# Note: Each increment doubles computation time
PASSWORD_HASH_ROUNDS=12

# API Rate Limit
# --------------
# Global API rate limit (requests per minute)
# Required: No
# Default: 1000
API_RATE_LIMIT=1000

# ==================== CLOUD PROVIDERS - AWS ====================

# AWS Access Key ID
# -----------------
# AWS access key for programmatic access
# Required: Only if using AWS services
# Security: Use IAM roles on AWS, keys only for local/dev
AWS_ACCESS_KEY_ID=your-access-key-here

# AWS Secret Access Key
# ---------------------
# AWS secret key for programmatic access
# Required: Only if using AWS services
AWS_SECRET_ACCESS_KEY=your-secret-key-here

# AWS Default Region
# ------------------
# Default AWS region for services
# Required: Only if using AWS services
# Example: AWS_DEFAULT_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# AWS S3 Bucket Name
# ------------------
# S3 bucket for file storage
# Required: Only if using S3
# Example: AWS_S3_BUCKET=microagents-storage
AWS_S3_BUCKET=microagents-storage

# AWS S3 Endpoint
# ---------------
# Custom S3 endpoint (for local testing or other S3-compatible services)
# Required: No
# Example (LocalStack): http://localhost:4566
AWS_S3_ENDPOINT=

# AWS CloudWatch Log Group
# ------------------------
# CloudWatch log group name
# Required: Only if using CloudWatch logs
AWS_CLOUDWATCH_LOG_GROUP=microagents

# ==================== CLOUD PROVIDERS - AZURE ====================

# Azure Storage Connection String
# -------------------------------
# Connection string for Azure Blob Storage
# Required: Only if using Azure storage
# Format: DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=

# Azure Storage Container
# -----------------------
# Azure Blob Storage container name
# Required: Only if using Azure storage
AZURE_STORAGE_CONTAINER=microagents

# Azure Tenant ID
# ---------------
# Azure AD tenant ID for authentication
# Required: Only if using Azure AD
AZURE_TENANT_ID=

# Azure Client ID
# ---------------
# Azure AD client ID (application ID)
# Required: Only if using Azure AD
AZURE_CLIENT_ID=

# Azure Client Secret
# -------------------
# Azure AD client secret
# Required: Only if using Azure AD
AZURE_CLIENT_SECRET=

# ==================== CLOUD PROVIDERS - GOOGLE CLOUD ====================

# Google Cloud Project ID
# -----------------------
# Google Cloud project ID
# Required: Only if using Google Cloud services
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# Google Cloud Credentials JSON
# -----------------------------
# Path to Google Cloud service account JSON key file
# Required: Only if using Google Cloud services
# Alternative: Use GOOGLE_APPLICATION_CREDENTIALS environment variable
GOOGLE_CLOUD_CREDENTIALS_JSON=path/to/service-account.json

# Google Cloud Storage Bucket
# ---------------------------
# Google Cloud Storage bucket name
# Required: Only if using GCS
GOOGLE_STORAGE_BUCKET=microagents-storage

# ==================== EXTERNAL APIs - PAYMENT PROCESSING ====================

# Stripe Secret Key
# -----------------
# Stripe API secret key for production
# Required: Only if using Stripe
# Format: sk_live_... (production) or sk_test_... (test)
STRIPE_SECRET_KEY=sk_test_your_test_key_here

# Stripe Publishable Key
# ----------------------
# Stripe API publishable key for frontend
# Required: Only if using Stripe
# Format: pk_live_... (production) or pk_test_... (test)
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here

# Stripe Webhook Secret
# ---------------------
# Secret to verify Stripe webhook signatures
# Required: Only if using Stripe webhooks
# Get from: Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Default Currency
# -----------------------
# Default currency for Stripe payments
# Required: No
# Default: usd
STRIPE_DEFAULT_CURRENCY=usd

# ==================== EXTERNAL APIs - EMAIL SERVICES ====================

# Email Provider
# --------------
# Email service provider
# Required: Only if sending emails
# Values: smtp, sendgrid, ses, console (for development)
EMAIL_PROVIDER=smtp

# SMTP Host
# ---------
# SMTP server hostname
# Required: Only if EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com

# SMTP Port
# ---------
# SMTP server port
# Required: Only if EMAIL_PROVIDER=smtp
# Default: 587 (TLS), 465 (SSL)
SMTP_PORT=587

# SMTP Username
# -------------
# SMTP authentication username
# Required: Only if EMAIL_PROVIDER=smtp
SMTP_USERNAME=your-email@gmail.com

# SMTP Password
# -------------
# SMTP authentication password (use app password for Gmail)
# Required: Only if EMAIL_PROVIDER=smtp
SMTP_PASSWORD=your-app-password

# SMTP Use TLS
# ------------
# Use TLS for SMTP connection
# Required: No
# Default: true
SMTP_USE_TLS=true

# SendGrid API Key
# ----------------
# SendGrid API key for sending emails
# Required: Only if EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# AWS SES Region
# --------------
# AWS region for SES (Simple Email Service)
# Required: Only if EMAIL_PROVIDER=ses
AWS_SES_REGION=us-east-1

# Email From Address
# ------------------
# Default sender email address
# Required: Only if sending emails
# Example: EMAIL_FROM_ADDRESS=noreply@microagents.io
EMAIL_FROM_ADDRESS=noreply@microagents.io

# Email From Name
# ---------------
# Default sender name
# Required: No
# Default: MicroAgents Platform
EMAIL_FROM_NAME=MicroAgents Platform

# ==================== EXTERNAL APIs - MONITORING & ANALYTICS ====================

# Datadog API Key
# ---------------
# Datadog API key for metrics and traces
# Required: Only if using Datadog
DATADOG_API_KEY=your_datadog_api_key

# Datadog Site
# ------------
# Datadog site (datadoghq.com, datadoghq.eu, etc.)
# Required: Only if using Datadog
# Default: datadoghq.com
DATADOG_SITE=datadoghq.com

# New Relic License Key
# ---------------------
# New Relic license key for APM
# Required: Only if using New Relic
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key

# New Relic App Name
# ------------------
# New Relic application name
# Required: Only if using New Relic
NEW_RELIC_APP_NAME=MicroAgents Platform

# Sentry DSN
# ----------
# Sentry DSN for error tracking
# Required: Only if using Sentry
# Format: https://key@sentry.io/project
SENTRY_DSN=https://key@sentry.io/project

# OpenTelemetry Endpoint
# ----------------------
# OpenTelemetry collector endpoint
# Required: Only if using OpenTelemetry
# Example: http://localhost:4318 (HTTP) or localhost:4317 (gRPC)
OPENTELEMETRY_ENDPOINT=http://localhost:4318

# ==================== EXTERNAL APIs - FEATURE FLAGS ====================

# Feature Flag Provider
# ---------------------
# Feature flag service provider
# Required: No
# Values: unleash, launchdarkly, local
# Default: local
FEATURE_FLAG_PROVIDER=local

# Unleash API URL
# ---------------
# Unleash server API URL
# Required: Only if FEATURE_FLAG_PROVIDER=unleash
# Example: http://localhost:4242/api (local) or https://unleash.microagents.io/api
UNLEASH_API_URL=http://localhost:4242/api

# Unleash API Token
# -----------------
# Unleash API authentication token
# Required: Only if FEATURE_FLAG_PROVIDER=unleash
UNLEASH_API_TOKEN=your-unleash-token

# LaunchDarkly SDK Key
# --------------------
# LaunchDarkly SDK key
# Required: Only if FEATURE_FLAG_PROVIDER=launchdarkly
LAUNCHDARKLY_SDK_KEY=your-launchdarkly-sdk-key

# ==================== SAAS CONFIGURATION ====================

# SaaS Base URL
# -------------
# Base URL for the SaaS application
# Required: Yes
# Example (production): https://app.microagents.io
# Example (staging): https://staging.microagents.io
SAAS_BASE_URL=http://localhost:3000

# SaaS API URL
# ------------
# API base URL
# Required: Yes
# Example (production): https://api.microagents.io
SAAS_API_URL=http://localhost:8000

# SaaS Admin Email
# ----------------
# Default admin email for superuser access
# Required: Yes
# Security: Change in production
SAAS_ADMIN_EMAIL=admin@microagents.io

# SaaS Support Email
# ------------------
# Support contact email
# Required: No
# Default: support@microagents.io
SAAS_SUPPORT_EMAIL=support@microagents.io

# SaaS Billing Contact Email
# --------------------------
# Billing contact email
# Required: No
# Default: billing@microagents.io
SAAS_BILLING_EMAIL=billing@microagents.io

# SaaS Default Timezone
# ---------------------
# Default timezone for the application
# Required: No
# Default: UTC
SAAS_DEFAULT_TIMEZONE=UTC

# SaaS Default Currency
# ---------------------
# Default currency for pricing
# Required: No
# Default: USD
SAAS_DEFAULT_CURRENCY=USD

# SaaS Free Trial Days
# --------------------
# Number of days for free trial
# Required: No
# Default: 14
SAAS_FREE_TRIAL_DAYS=14

# ==================== PERFORMANCE CONFIGURATION ====================

# Worker Concurrency
# ------------------
# Number of concurrent worker processes
# Required: No
# Default: 4
# Formula: CPU cores * 2 + 1
WORKER_CONCURRENCY=4

# Worker Memory Limit
# -------------------
# Memory limit per worker in megabytes
# Required: No
# Default: 512
WORKER_MEMORY_LIMIT=512

# Task Queue Name
# ---------------
# Celery task queue name
# Required: Only if using Celery
# Default: microagents
TASK_QUEUE_NAME=microagents

# Task Result Backend
# -------------------
# Celery result backend
# Required: Only if using Celery
# Default: redis (use same as REDIS_URL)
TASK_RESULT_BACKEND=redis://localhost:6379/1

# ==================== DEVELOPMENT & TESTING ====================

# Development Mode
# ----------------
# Enable development-only features
# Required: No
# Default: false
# Security: DO NOT enable in production
DEVELOPMENT_MODE=false

# Test Database URL
# -----------------
# Database URL for tests (usually in-memory SQLite)
# Required: Only for testing
# Example: sqlite:///:memory:
TEST_DATABASE_URL=sqlite:///:memory:

# Auto Migrate Database
# ---------------------
# Automatically run database migrations on startup
# Required: No
# Default: false
# Production: false (use CI/CD pipeline)
AUTO_MIGRATE_DATABASE=false

# Seed Sample Data
# ----------------
# Seed database with sample data on startup
# Required: No
# Default: false
# Production: false
SEED_SAMPLE_DATA=false

# ==================== ADVANCED CONFIGURATION ====================

# API Request Timeout
# -------------------
# API request timeout in seconds
# Required: No
# Default: 30
API_REQUEST_TIMEOUT=30

# API CORS Origins
# ----------------
# CORS allowed origins (comma-separated)
# Required: No
# Default: *
# Production: Restrict to your domains
API_CORS_ORIGINS=*

# API Rate Limit Storage
# ----------------------
# Storage backend for rate limiting
# Required: No
# Values: memory, redis
# Default: redis
API_RATE_LIMIT_STORAGE=redis

# Session Secret
# --------------
# Secret for session encryption
# Required: Only if using sessions
# Generation: `openssl rand -hex 32`
SESSION_SECRET=changeme-session-secret-32-chars-minimum

# Session Timeout
# ---------------
# Session timeout in minutes
# Required: No
# Default: 120 (2 hours)
SESSION_TIMEOUT=120

# File Upload Max Size
# --------------------
# Maximum file upload size in megabytes
# Required: No
# Default: 10
FILE_UPLOAD_MAX_SIZE_MB=10

# Allowed File Extensions
# -----------------------
# Comma-separated list of allowed file extensions
# Required: No
# Default: pdf,doc,docx,png,jpg,jpeg,gif
ALLOWED_FILE_EXTENSIONS=pdf,doc,docx,png,jpg,jpeg,gif

# ==================== DEPRECATED (FOR REFERENCE) ====================

# OLD_DATABASE_URL
# ----------------
# Previous database URL for migration reference
# Required: No
# Security: Remove after migration
# OLD_DATABASE_URL=postgresql://olduser:oldpass@oldhost:5432/olddb

# =============================================================================
# END OF ENVIRONMENT VARIABLES
# =============================================================================

# To validate your configuration:
# 1. Copy this file to .env: `cp .env.template .env`
# 2. Fill in required values
# 3. Run validation: `python scripts/validate_env.py`
# 4. For production: Use secrets manager, not .env files
#
# Security Best Practices:
# - Never commit .env files to version control
# - Use environment-specific .env files (.env.production, .env.staging)
# - Rotate secrets regularly (90 days recommended)
# - Use IAM roles instead of access keys on cloud platforms
# - Encrypt secrets at rest and in transit
#
# Production Deployment:
# - Use AWS Secrets Manager, Azure Key Vault, or HashiCorp Vault
# - Set environment variables in container orchestration (K8s, ECS)
# - Use parameter store for non-secret configuration
# =============================================================================